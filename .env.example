# Bot token from the Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application (Client) ID from -> General Information -> Application ID
CLIENT_ID=

# Optional: your server (guild) ID for instant slash-command registration.
# Right-click your server icon with Developer Mode on -> Copy Server ID.
# Leave blank to register globally (can take up to ~1 hour to appear).
GUILD_ID=

# Optional (hosting): set to "true" to register slash commands automatically on
# boot, so you don't need a separate `npm run register` step on a host.
REGISTER_ON_START=

# Optional (hosting): directory for the persistent strikes.json store. Point this
# at a mounted volume (e.g. /data) so strike counts survive redeploys. Defaults
# to the project folder when unset.
DATA_DIR=
